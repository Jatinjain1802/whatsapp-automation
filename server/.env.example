# --- Server ---
PORT=4000
HOST=0.0.0.0
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me-in-production

# --- MongoDB ---
# Local (docker compose): mongodb://localhost:27017/whatsapp-automation
# Atlas: mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/whatsapp_automation?retryWrites=true&w=majority
# (Atlas: also allow your server IP under Network Access, and keep the
#  password out of git - this file is the template, .env is gitignored.)
MONGODB_URI=mongodb://localhost:27017/whatsapp-automation
# Pool size per process (API and worker each open their own connection).
MONGO_MAX_POOL_SIZE=50

# --- Redis (BullMQ queues) ---
REDIS_URL=redis://localhost:6379

# --- Send throughput ---
# Stay inside Meta's per-number Cloud API throughput and your portfolio's
# messaging-limit tier (new portfolios start around 250 business-initiated
# conversations/24h and scale up with quality rating).
SEND_RATE_LIMIT_MAX=20
SEND_RATE_LIMIT_MS=1000
SEND_CONCURRENCY=10

# --- Bulk batch sizes (docs per Mongo round trip) ---
IMPORT_BATCH_SIZE=1000
CAMPAIGN_BATCH_SIZE=2000

# --- Meta WhatsApp Business Cloud API ---
META_API_VERSION=v21.0
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
