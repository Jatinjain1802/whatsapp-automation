# Server
PORT=4000
CLIENT_URL=http://localhost:5173

# Database / queue
MONGODB_URI=mongodb://localhost:27017/whatsapp-automation
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Meta WhatsApp Business Cloud API
# Get these from https://developers.facebook.com/apps -> your app -> WhatsApp -> API setup
META_API_VERSION=v21.0
META_WHATSAPP_ACCESS_TOKEN=EAAG...           # System-user permanent token for production; temp token for testing
META_WHATSAPP_BUSINESS_ACCOUNT_ID=           # WABA ID
META_WHATSAPP_PHONE_NUMBER_ID=               # Phone number ID (not the phone number itself)
META_APP_SECRET=                             # App secret, used to verify webhook signatures
META_WEBHOOK_VERIFY_TOKEN=any-random-string  # You invent this; enter the same value in the Meta webhook config
